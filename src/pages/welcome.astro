---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Welcome to Siplinx AI - Download Starting',
  description: 'Thank you for signing in. Your download is starting automatically.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-violet-50 dark:from-[#06051A] dark:via-[#060512] dark:to-[#0A0618]"
    >
    </div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-violet-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative text-center px-4 max-w-lg mx-auto">
      <div
        id="icon-wrap"
        class="w-20 h-20 mx-auto mb-6 rounded-full bg-green-100 dark:bg-green-900/40 flex items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-10 h-10 text-green-600 dark:text-green-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <!-- Step-by-step state -->
      <div id="steps">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-3">You're in!</h1>
        <p class="text-gray-500 dark:text-slate-400 mb-4">
          Follow the steps below to download and finish setup.
        </p>

        <div
          class="mb-8 px-5 py-4 rounded-xl bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 text-left"
        >
          <p class="font-semibold text-blue-900 dark:text-blue-200">Please wait - your download has started.</p>
          <p class="text-sm text-blue-800 dark:text-blue-300 mt-1">
            Check your browser's downloads. Open the file and install it, then come back to this page and press
            <strong>Next</strong> below.
          </p>
          <p class="font-semibold text-blue-900 dark:text-blue-200 mt-3">Note: You must complete authorization after downloading to use the app.</p>
        </div>

        <ol class="text-left space-y-5 mb-8">
          <li class="flex gap-4">
            <span
              class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-violet-600 text-white font-bold flex items-center justify-center text-sm"
              >1</span
            >
            <div>
              <p class="font-semibold text-gray-900 dark:text-white">Download Siplinx AI</p>
              <p class="text-sm text-gray-500 dark:text-slate-400">
                Your download should start automatically.
                <a id="dl-manual" href="#" class="text-blue-600 dark:text-blue-400 underline"
                  >Click here if it doesn't start</a
                >.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span
              class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-violet-600 text-white font-bold flex items-center justify-center text-sm"
              >2</span
            >
            <div>
              <p class="font-semibold text-gray-900 dark:text-white">Install it</p>
              <p class="text-sm text-gray-500 dark:text-slate-400">
                Open the downloaded file and follow the installer steps.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span
              class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-violet-600 text-white font-bold flex items-center justify-center text-sm"
              >3</span
            >
            <div>
              <p class="font-semibold text-gray-900 dark:text-white">Come back and authorize</p>
              <p class="text-sm text-gray-500 dark:text-slate-400 mb-3">
                Once it's installed, click the button below to complete authorization.
              </p>
              <button
                id="btn-done"
                type="button"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-violet-600 text-white font-semibold shadow hover:scale-105 transition-all duration-200"
              >
                I've installed it - Next
              </button>
            </div>
          </li>
        </ol>

        <p class="text-xs text-gray-400 dark:text-slate-500">
          Need help? <a href="/help/" class="underline hover:text-blue-500">Visit our Help Center</a>
        </p>
      </div>

      <!-- Confirmed state -->
      <div id="done" class="hidden">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-3">All set!</h1>
        <p class="text-gray-500 dark:text-slate-400">
          Open Siplinx AI on your computer and sign in to start your first meeting.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // The Google auth flow always lands here regardless of which site language
  // the visitor started from. If they started on the Russian site, bounce
  // them to the Russian version before doing anything else.
  const storedLang = (() => {
    try {
      return localStorage.getItem('siplinx_lang');
    } catch {
      return null;
    }
  })();
  const params = new URLSearchParams(window.location.search);
  const isAuthSuccess = params.get('auth_success') === '1';

  const isRu = storedLang ? storedLang === 'ru' : navigator.language.toLowerCase().startsWith('ru');

  if (isRu && !isAuthSuccess) {
    window.location.replace(`/ru/welcome/${window.location.search}`);
  } else {
    if (isAuthSuccess) {
      // Mark user as authenticated for future visits
      localStorage.setItem('siplinx_authed', '1');
      document.getElementById('steps')?.classList.add('hidden');
      document.getElementById('done')?.classList.remove('hidden');
    } else {
      const variant = params.get('variant');
      const downloadUrl =
        variant === 'direct'
          ? 'https://siplinx-ai.vercel.app/download?variant=direct'
          : 'https://siplinx-ai.vercel.app/download';

      const manualLink = document.getElementById('dl-manual') as HTMLAnchorElement | null;
      if (manualLink) manualLink.href = downloadUrl;

      // Trigger the download right away - no artificial delay.
      window.location.href = downloadUrl;

      const ph = (window as unknown as Record<string, unknown>).__ph as
        | ((ev: string, p?: Record<string, unknown>) => void)
        | undefined;

      document.getElementById('btn-done')?.addEventListener('click', () => {
        ph?.('install_confirmed', { lang: 'en', variant: variant || 'default' });

        // Trigger auth flow
        import('~/utils/download-redirect').then(({ buildAuthRedirectUrl }) => {
          const currentUrl = new URL(window.location.href);
          currentUrl.searchParams.set('auth_success', '1');
          window.location.href = buildAuthRedirectUrl(currentUrl.toString());
        });
      });
    }
  }
</script>
